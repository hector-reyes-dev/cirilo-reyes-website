---
import BaseLayout from '@layouts/BaseLayout.astro';
import IconCircle from '@components/IconCircle.astro';
import {
  heroContent,
  differentiators,
  services,
  audienceProfile,
  calloutCopy,
  philosophy,
  finalCta,
  pageSeo
} from '@constants/home';

const navLinks = [
  { label: 'Propuesta de valor', href: '#diferenciadores' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Clientes', href: '#clientes' },
  { label: 'Filosofía', href: '#filosofia' }
];
---
<BaseLayout title={pageSeo.title} description={pageSeo.description}>
  <header class="sticky top-0 z-40 border-b border-border/60 bg-background/90 backdrop-blur">
    <div class="content-wrapper flex items-center gap-4 py-4">
      <a class="font-serif text-xl font-semibold tracking-tight" href="#inicio" aria-label="Ir al inicio">
        Cirilo Reyes
      </a>
      <nav class="ml-auto hidden gap-8 text-sm font-medium md:flex">
        {navLinks.map((link) => (
          <a href={link.href} class="text-secondary transition hover:text-foreground" aria-label={link.label}>
            {link.label}
          </a>
        ))}
      </nav>
      <a class="btn hidden md:inline-flex" href={heroContent.primaryCta.href} target="_blank" rel="noreferrer">
        Agenda una consulta
      </a>
      <details class="ml-auto w-full md:hidden">
        <summary class="flex cursor-pointer items-center justify-between rounded-md border border-border px-3 py-2 text-sm font-semibold">
          Menú
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="mt-2 space-y-1 rounded-md border border-border bg-background/95 p-3 text-sm font-medium">
          {navLinks.map((link) => (
            <a href={link.href} class="block rounded px-2 py-1 text-secondary hover:bg-border/20" aria-label={link.label}>
              {link.label}
            </a>
          ))}
          <a
            href={heroContent.primaryCta.href}
            class="btn mt-2 w-full justify-center"
            target="_blank"
            rel="noreferrer"
          >
            Agenda una consulta
          </a>
        </div>
      </details>
    </div>
  </header>

  <main id="contenido" class="space-y-20 pb-20 pt-12">
    <section id="inicio" class="content-wrapper grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
      <div class="space-y-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">{heroContent.eyebrow}</p>
        <div class="space-y-4">
          <h1 class="font-serif text-4xl leading-tight text-foreground sm:text-5xl">
            {heroContent.title}
          </h1>
          <p class="text-lg text-secondary">{heroContent.subtitle}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a class="btn justify-center" href={heroContent.primaryCta.href}>{heroContent.primaryCta.label}</a>
          <a class="btn-outline justify-center" href={heroContent.secondaryCta.href}>{heroContent.secondaryCta.label}</a>
        </div>
        <ul class="space-y-3">
          {heroContent.highlights.map((item) => (
            <li class="flex items-start gap-3 text-sm text-secondary">
              <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-primary/10 text-primary">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="h-3 w-3">
                  <path d="M3 8l3 3 7-7" />
                </svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <aside class="rounded-2xl border border-border bg-background/80 p-6 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Confiabilidad</p>
        <p class="mt-3 text-lg font-serif leading-relaxed text-foreground">{heroContent.trustNote}</p>
        <dl class="mt-6 grid gap-4 text-sm text-secondary sm:grid-cols-2">
          {heroContent.trustSignals.map((signal) => (
            <div>
              <dt class="font-semibold text-foreground">{signal.label}</dt>
              <dd>{signal.description}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </section>

    <section id="diferenciadores" class="content-wrapper space-y-8">
      <div class="space-y-3">
        <p class="text-sm font-semibold text-primary">Propuesta de valor diferenciadora</p>
        <h2 class="font-serif text-3xl text-foreground">¿Qué nos hace diferentes?</h2>
        <p class="text-secondary text-base">
          Integramos disciplinas, mantenemos rigor técnico y acompañamos con un enfoque pedagógico para que cada decisión estratégica tenga contexto y respaldo.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {differentiators.map((item) => (
          <article class="flex flex-col gap-4 rounded-2xl border border-border/70 bg-background/60 p-6 shadow-sm">
            <IconCircle name={item.icon} />
            <h3 class="text-xl font-serif text-foreground">{item.title}</h3>
            <p class="text-secondary text-sm leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="servicios" class="content-wrapper space-y-8">
      <div class="space-y-3">
        <p class="text-sm font-semibold text-primary">Servicios integrados</p>
        <h2 class="font-serif text-3xl">Servicios que protegen y potencian tu empresa</h2>
        <p class="text-secondary text-base">Seis líneas complementarias para cubrir el espectro contable, fiscal y jurídico.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {services.map((service) => (
          <article class="flex h-full flex-col gap-4 rounded-2xl border border-border/80 bg-background/70 p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <IconCircle name={service.icon} />
            <div>
              <h3 class="text-xl font-serif text-foreground">{service.title}</h3>
              <p class="mt-2 text-sm text-secondary">{service.description}</p>
            </div>
            <ul class="space-y-2 text-sm text-secondary">
              {service.highlights.map((point) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
                  {point}
                </li>
              ))}
            </ul>
            <a
              href={service.href}
              target="_blank"
              rel="noreferrer"
              class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-primary"
            >
              Hablar sobre este servicio
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 10h10M11 6l4 4-4 4" />
              </svg>
            </a>
          </article>
        ))}
      </div>
      <div class="flex justify-center">
        <a href="#servicios" class="btn-outline">Explorar servicios →</a>
      </div>
    </section>

    <section id="clientes" class="content-wrapper space-y-8">
      <div class="space-y-3 max-w-3xl">
        <p class="text-sm font-semibold text-primary">Para quién trabajamos</p>
        <h2 class="font-serif text-3xl">{audienceProfile.title}</h2>
        <p class="text-secondary text-base">{audienceProfile.intro}</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
        <div class="space-y-6 rounded-2xl border border-border/70 bg-background/70 p-6">
          <dl class="grid gap-4 text-sm sm:grid-cols-3">
            {audienceProfile.stats.map((stat) => (
              <div>
                <dt class="text-secondary">{stat.label}</dt>
                <dd class="text-lg font-semibold text-foreground">{stat.value}</dd>
              </div>
            ))}
          </dl>
          <div>
            <h3 class="text-base font-semibold text-foreground">Industrias clave</h3>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {audienceProfile.industries.map((industry) => (
                <li class="rounded-lg border border-border px-3 py-2 text-sm text-secondary">{industry}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-base font-semibold text-foreground">Necesidades críticas</h3>
            <ul class="mt-3 space-y-2 text-sm text-secondary">
              {audienceProfile.needs.map((need) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
                  {need}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="rounded-2xl border border-primary/20 bg-primary/5 p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">{calloutCopy.title}</p>
          <p class="mt-3 text-secondary">{calloutCopy.body}</p>
        </div>
      </div>
    </section>

    <section id="filosofia" class="content-wrapper space-y-8">
      <div class="space-y-3 max-w-3xl">
        <p class="text-sm font-semibold text-primary">Filosofía de trabajo</p>
        <h2 class="font-serif text-3xl">{philosophy.title}</h2>
        <p class="text-secondary text-base">{philosophy.intro}</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
        <div class="space-y-4">
          {philosophy.pillars.map((pillar) => (
            <article class="rounded-2xl border border-border/70 bg-background/70 p-5">
              <h3 class="text-lg font-semibold text-foreground">{pillar.title}</h3>
              <p class="mt-2 text-sm text-secondary">{pillar.description}</p>
            </article>
          ))}
        </div>
        <aside class="rounded-2xl border border-border bg-background p-6 shadow-sm">
          <h3 class="text-base font-semibold text-foreground">{philosophy.technology.title}</h3>
          <p class="mt-2 text-sm text-secondary">{philosophy.technology.description}</p>
        </aside>
      </div>
    </section>

    <section id="contacto" class="content-wrapper">
      <div class="rounded-3xl border border-primary/30 bg-primary/10 p-10 text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">Próximos pasos</p>
        <h2 class="mt-4 font-serif text-3xl text-foreground">{finalCta.title}</h2>
        <p class="mt-3 text-secondary text-base">{finalCta.description}</p>
        <div class="mt-6 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a class="btn" href={finalCta.button.href} target="_blank" rel="noreferrer">
            {finalCta.button.label}
          </a>
          <a class="btn-outline" href={finalCta.button.href} target="_blank" rel="noreferrer">
            Enviar mensaje por WhatsApp
          </a>
        </div>
        <p class="mt-4 text-xs text-secondary">{finalCta.note}</p>
      </div>
    </section>
  </main>

  <footer class="border-t border-border/60 bg-background py-8">
    <div class="content-wrapper flex flex-col gap-4 text-sm text-secondary md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} Cirilo Reyes. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#inicio" class="hover:text-foreground">Aviso de privacidad</a>
        <a
          href={finalCta.button.href}
          target="_blank"
          rel="noreferrer"
          class="hover:text-foreground"
        >
          WhatsApp: +52 55 2774 3347
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
