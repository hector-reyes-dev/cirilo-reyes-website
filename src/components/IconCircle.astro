---
type IconName =
  | 'puzzle'
  | 'shield'
  | 'book'
  | 'scale'
  | 'ledger'
  | 'gavel'
  | 'spark'
  | 'merge'
  | 'radar';

interface Props {
  name: IconName;
}

const { name } = Astro.props as Props;
---
<div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
  {name === 'puzzle' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M9 3h2.5a2.5 2.5 0 0 1 0 5H9v2.5a2.5 2.5 0 0 1-5 0V9H3" />
      <path d="M15 21h-2.5a2.5 2.5 0 0 1 0-5H15v-2.5a2.5 2.5 0 0 1 5 0V15h1" />
      <path d="M9 9h6v6H9z" />
    </svg>
  )}
  {name === 'shield' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z" />
      <path d="M9 13.5 11 15l4-4" />
    </svg>
  )}
  {name === 'book' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 4h6a3 3 0 0 1 3 3v13H8a3 3 0 0 0-3 3z" />
      <path d="M19 4h-6a3 3 0 0 0-3 3v13h6a3 3 0 0 1 3 3z" />
    </svg>
  )}
  {name === 'scale' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 3v18" />
      <path d="M5 7h14" />
      <path d="M7 7 4 13.5a3 3 0 0 0 6 0z" />
      <path d="M17 7l3 6.5a3 3 0 0 1-6 0z" />
    </svg>
  )}
  {name === 'ledger' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="4" y="3" width="16" height="18" rx="2" />
      <path d="M8 7h4M8 11h8M8 15h6" />
    </svg>
  )}
  {name === 'gavel' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m13 2 4 4-7 7-4-4z" />
      <path d="M8 13 3 18" />
      <path d="M14 10 21 17" />
      <path d="M7 21h10" />
    </svg>
  )}
  {name === 'spark' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 2v4M12 18v4M4 12H2M22 12h-2M6.3 6.3 4.9 4.9M19.1 19.1l-1.4-1.4M17.7 6.3l1.4-1.4M4.9 19.1l1.4-1.4" />
      <circle cx="12" cy="12" r="3" />
    </svg>
  )}
  {name === 'merge' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 3v6a4 4 0 0 0 4 4h4" />
      <path d="M8 21v-8M8 7H4M8 17H4" />
      <circle cx="20" cy="13" r="2" />
      <circle cx="4" cy="7" r="2" />
      <circle cx="4" cy="17" r="2" />
    </svg>
  )}
  {name === 'radar' && (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="9" />
      <path d="M12 12 19 5" />
      <path d="M12 3v3M3 12h3M12 21v-3" />
      <circle cx="19" cy="5" r="1.5" fill="currentColor" stroke="none" />
    </svg>
  )}
</div>
