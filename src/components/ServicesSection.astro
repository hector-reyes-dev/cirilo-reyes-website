---
import SectionHeader from '@components/SectionHeader.astro';
import { services } from '@constants/home';
---

<section id="servicios" class="section-block section-block--tinted">
  <div class="content-wrapper">
    <SectionHeader
      tag="Servicios"
      title="¿En qué podemos ayudarte?"
      intro="Ofrecemos asesoría integral para que tu empresa o patrimonio esté siempre en orden y protegido."
    />

    <div class="services-grid" data-services-grid>
      {services.map((service, index) => (
        <article class="service-card" style={`--card-index: ${index}`}>
          <div class={`service-card__icon service-card__icon--${service.tone}`} aria-hidden="true">
            {service.icon}
          </div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul>
            {service.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const servicesGrid = document.querySelector('[data-services-grid]');
  const serviceCards = Array.from(document.querySelectorAll('.service-card'));

  if (servicesGrid instanceof HTMLElement) {
    serviceCards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;

      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
      });

      card.addEventListener('pointerenter', () => {
        serviceCards.forEach((candidate) => candidate.classList.toggle('is-muted', candidate !== card));
      });

      card.addEventListener('pointerleave', () => {
        serviceCards.forEach((candidate) => candidate.classList.remove('is-muted'));
      });
    });
  }
</script>
